#include <Arduino.h>

/* ================= PIN CONFIG ================= */
const int BTN_POWER = 2;   // GP2
const int BTN_UP    = 5;   // GP5
const int BTN_DOWN  = 6;   // GP6

const int LED_MANUAL = 10; // GP10
const int LED_SCENE  = 11; // GP11
const int LED_AUTO   = 12; // GP12

/* ================= TIMING CONFIG ================= */
const unsigned long DEBOUNCE_MS   = 30;
const unsigned long LONG_PRESS_MS = 1500;

/* ================= UART RX CONFIG ================= */
const int UART_LINE_MAX = 160;
char uartLine[UART_LINE_MAX];
int uartLineLen = 0;

/* ================= BUTTON STRUCT ================= */
struct Button {
  int pin;
  const char* name;

  bool stableState;        // true = pressed, false = released
  bool lastRawState;
  unsigned long lastChangeMs;

  unsigned long pressStartMs;
  bool longSent;
};

Button buttons[] = {
  {BTN_POWER, "POWER", false, false, 0, 0, false},
  {BTN_UP,    "UP",    false, false, 0, 0, false},
  {BTN_DOWN,  "DOWN",  false, false, 0, 0, false},
};

const int BTN_COUNT = sizeof(buttons) / sizeof(buttons[0]);

bool readButtonRaw(int pin) {
  return digitalRead(pin) == LOW;   // active-low
}

void emitJsonToSerial(Stream &port, const char* key, const char* type) {
  port.print("{\"event\":\"button\",\"key\":\"");
  port.print(key);
  port.print("\",\"type\":\"");
  port.print(type);
  port.println("\"}");
}

void sendEvent(const char* key, const char* type) {
  emitJsonToSerial(Serial, key, type);
  emitJsonToSerial(Serial1, key, type);
}

void sendReadySignal() {
  Serial.println();
  Serial1.println();
  sendEvent("SYSTEM", "pico_ready");
}

void setModeLeds(bool manualOn, bool sceneOn, bool autoOn) {
  digitalWrite(LED_MANUAL, manualOn ? HIGH : LOW);
  digitalWrite(LED_SCENE, sceneOn ? HIGH : LOW);
  digitalWrite(LED_AUTO, autoOn ? HIGH : LOW);
}

void applyModePayload(const char* line) {
  String msg(line);

  if (msg.indexOf("\"type\":\"mode\"") < 0) {
    return;
  }

  if (msg.indexOf("\"power_state\":\"OFF\"") >= 0) {
    setModeLeds(false, false, false);
    Serial.println("MODE LED: OFF");
    return;
  }

  if (msg.indexOf("\"control_mode\":\"MANUAL\"") >= 0) {
    setModeLeds(true, false, false);
    Serial.println("MODE LED: MANUAL");
  } else if (msg.indexOf("\"control_mode\":\"SCENE\"") >= 0) {
    setModeLeds(false, true, false);
    Serial.println("MODE LED: SCENE");
  } else if (msg.indexOf("\"control_mode\":\"AUTO\"") >= 0) {
    setModeLeds(false, false, true);
    Serial.println("MODE LED: AUTO");
  }
}

void pollModeFromSerial1() {
  while (Serial1.available()) {
    char c = (char)Serial1.read();

    if (c == '\r') {
      continue;
    }

    if (c == '\n') {
      if (uartLineLen > 0) {
        uartLine[uartLineLen] = '\0';
        applyModePayload(uartLine);
        uartLineLen = 0;
      }
      continue;
    }

    if (uartLineLen < UART_LINE_MAX - 1) {
      uartLine[uartLineLen++] = c;
    } else {
      uartLineLen = 0;
    }
  }
}

void updateButton(Button &b) {
  bool raw = readButtonRaw(b.pin);
  unsigned long now = millis();

  if (raw != b.lastRawState) {
    b.lastRawState = raw;
    b.lastChangeMs = now;

    Serial.print("RAW ");
    Serial.print(b.name);
    Serial.print(" = ");
    Serial.println(raw ? "PRESSED" : "RELEASED");
  }

  if ((now - b.lastChangeMs) > DEBOUNCE_MS) {
    if (raw != b.stableState) {
      b.stableState = raw;

      if (b.stableState) {
        b.pressStartMs = now;
        b.longSent = false;

        Serial.print("STABLE PRESSED: ");
        Serial.println(b.name);
      } else {
        Serial.print("STABLE RELEASED: ");
        Serial.println(b.name);

        if (!b.longSent) {
          sendEvent(b.name, "short");
        }
      }
    }
  }

  if (b.stableState && !b.longSent) {
    if ((now - b.pressStartMs) > LONG_PRESS_MS) {
      sendEvent(b.name, "long");
      b.longSent = true;
    }
  }
}

void setup() {
  pinMode(BTN_POWER, INPUT_PULLUP);
  pinMode(BTN_UP, INPUT_PULLUP);
  pinMode(BTN_DOWN, INPUT_PULLUP);

  pinMode(LED_MANUAL, OUTPUT);
  pinMode(LED_SCENE, OUTPUT);
  pinMode(LED_AUTO, OUTPUT);
  setModeLeds(false, false, false);

  Serial.begin(115200);
  delay(1000);
  Serial.println("PICO BUTTON UART START");

  Serial1.setTX(0);
  Serial1.setRX(1);
  Serial1.begin(115200);

 for (int i = 0; i < BTN_COUNT; i++) {
  bool s = readButtonRaw(buttons[i].pin);
  buttons[i].stableState = s;
  buttons[i].lastRawState = s;
  buttons[i].lastChangeMs = millis();
  buttons[i].pressStartMs = millis();
  buttons[i].longSent = false;

  Serial.print("INIT ");
  Serial.print(buttons[i].name);
  Serial.print(" = ");
  Serial.println(s ? "PRESSED" : "RELEASED");
}

  sendReadySignal();
}

void loop() {
  pollModeFromSerial1();

  for (int i = 0; i < BTN_COUNT; i++) {
    updateButton(buttons[i]);
  }

  delay(10);
}
