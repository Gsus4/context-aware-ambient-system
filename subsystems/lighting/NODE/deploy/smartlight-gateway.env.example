# NODE final C convergence env example
# 正式 gateway 目錄：NODE/gateway_c
# Python legacy 僅保留在 ARCHIVE/NODE_gateway_legacy 作為對照，不再作為正式啟動入口。

# 目標模式：SERVER 是唯一正式控制入口；NODE 只跑 bridge/service，
# 只有在 debug/維護時才登入 NODE。

# SmartLight 半正式部署環境檔範例
# 複製到 /etc/default/smartlight-gateway 後再依實際環境修改。

MQTT_BROKER_CANDIDATES="<broker-ip-1> <broker-ip-2>"
# MQTT_BROKER_HOST=<single-broker-ip>
MQTT_BROKER_PORT=1883
MQTT_KEEPALIVE=30
MQTT_USERNAME=smartlight-node-bedroom01
# 建議正式部署時使用檔案，不要把密碼直接寫在 env。
MQTT_PASSWORD_FILE=/etc/smartlight/node-bedroom01.mqtt.password
# MQTT_PASSWORD=change-me-only-for-lab
MQTT_CLIENT_ID=smartlight-gateway-bedroom01-driver
MQTT_CLEAN_SESSION=false
MQTT_CONNECT_TIMEOUT=10
MQTT_RECONNECT_MIN_DELAY=1
MQTT_RECONNECT_MAX_DELAY=30
MQTT_MAX_QUEUED_MESSAGES=200
MQTT_MAX_INFLIGHT_MESSAGES=20
MQTT_COMMAND_SUBSCRIBE_QOS=1
MQTT_ACK_QOS=1
MQTT_STATUS_QOS=0
MQTT_EVENT_QOS=0
MQTT_INTERNAL_TOPIC_BASE=smartlight
INTEGRATION_ENABLED=false
INTEGRATION_TOPIC_BASE=smartlight

NODE_ID=bedroom01
TRANSPORT_MODE=driver
SERIAL_PORT=/dev/serial0
SERIAL_BAUDRATE=115200
SERIAL_TIMEOUT=0.2
TRANSPORT_RECONNECT_DELAY=1.0
TRANSPORT_AUTO_RESYNC=false
DRIVER_DEVICE=/dev/smartlight0
SMARTLIGHT_DEVICE_MODE=0660
SMARTLIGHT_DEVICE_GROUP=@RUN_GROUP@

DEBUG=true
COMMAND_QUEUE_MAX=64
OFFLINE_QUEUE_MAX=200
COMMAND_TIMEOUT=2.0
DEFAULT_MANUAL_BRIGHTNESS=64
STATUS_POLL_TIMEOUT=2.5
STATUS_PUBLISH_INTERVAL=5.0
STATUS_SYNC_COOLDOWN=0.6
DRIVER_STATUS_FROM_IOCTL=true
DRIVER_STATUS_IOCTL_INTERVAL=2.0
FLOW_GRADIENT_TIMEOUT=6.0
STARTUP_STATUS_SYNC=false
STARTUP_STATUS_TIMEOUT=3.0
ALLOW_MULTI_GATEWAY=false
PROCESS_LOCK_FILE=/tmp/smartlight-gateway-bedroom01.lock
LOG_DIR=@SERVICE_ROOT@/logs/runtime/deploy
