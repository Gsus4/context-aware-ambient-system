# FastAPI Dashboard
PORT=3000
DASHBOARD_DIR=src/smart_space/web/dashboard

# Light / SmartLight MQTT Broker
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
SMARTLIGHT_NODE_ID=bedroom01
SMARTLIGHT_TOPIC_ROOT=smartlight

# Smart Platform topic root: integration/smart/v1/{domain}/{node_id}/{type}
INTEGRATION_TOPIC_ROOT=integration/smart/v1
CONTROLLER_NODE_ID=smart_space_master

# Wearable / Heart Rate / SpO2 MQTT Broker
WEARABLE_MQTT_ENABLED=true
WEARABLE_MQTT_HOST=localhost
WEARABLE_MQTT_PORT=1883
WEARABLE_MQTT_USERNAME=
WEARABLE_MQTT_PASSWORD=
WEARABLE_NODE_ID=pico_wearable01

# Env / Temperature / Humidity / AQI / PIR / Fan MQTT Broker
ENV_MQTT_ENABLED=true
ENV_MQTT_HOST=pi5203.local
ENV_MQTT_PORT=1883
ENV_MQTT_USERNAME=
ENV_MQTT_PASSWORD=
ENV_SENSOR_NODE_ID=rpi_env01
FAN_NODE_ID=rpi_env02

# Optional Smart Platform v2 light node
LIGHT_INTEGRATION_NODE_ID=rpi_light01

# Optional extra subscriptions for future audio/camera modules
DASHBOARD_EXTRA_SUB_TOPICS=

# Local GPIO activation button on Raspberry Pi 4B.
# Default wiring: physical pin 11 (GPIO17/BCM17) to physical pin 6 (GND).
# The reader uses the internal pull-up resistor; do not wire the button to 5V.
GPIO_BUTTON_ENABLED=true
GPIO_BUTTON_PIN=17
GPIO_BUTTON_BOUNCE_SECONDS=0.1

# Camera / MediaMTX
CAMERA_ENABLED=true
CAMERA_STREAM_PATH=space
CAMERA_PUBLIC_HOST=s10RPi4
CAMERA_RTSP_PORT=8554
CAMERA_HLS_PORT=8888
CAMERA_WEBRTC_PORT=8889
CAMERA_WIDTH=960
CAMERA_HEIGHT=720
CAMERA_FPS=24
CAMERA_BITRATE=2000000
CAMERA_MEDIAMTX_BIN=mediamtx/mediamtx
CAMERA_MEDIAMTX_CONFIG=mediamtx/mediamtx.yml

# AI Scene Awareness
# GOOGLE_API_KEY can also be read from drafts/sence_aware/.env as a local fallback.
GOOGLE_API_KEY=
SCENE_AWARENESS_ENABLED=true
SCENE_AWARENESS_MODEL=gemma-4-31b-it
SCENE_AWARENESS_CAPTURE_INTERVAL_SECONDS=5
SCENE_AWARENESS_INFER_INTERVAL_SECONDS=30
SCENE_AWARENESS_PROMPT_PATH=src/smart_space/config/scene_awareness_system_prompt.txt
SCENE_AWARENESS_ENV_FALLBACK_PATH=drafts/sence_aware/.env
SCENE_AWARENESS_LOG_PATH=.runtime/scene_awareness.log

# Profile storage
LED_PROFILE_DEFAULT_PATH=src/smart_space/config/led_profiles.default.json
LED_PROFILE_USER_PATH=src/smart_space/data/led_profiles.user.json
